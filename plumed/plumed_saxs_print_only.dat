# Stock-PLUMED approximate monitoring of XRD-like Debye intensities via SAXS.
# This is useful for checking that PLUMED/LAMMPS is wired, but it is not exactly
# the Niu et al. paper CV because stock SAXS is not the same customized XRD peak CV.

UNITS LENGTH=A TIME=fs ENERGY=kcal/mol
MOLINFO STRUCTURE=structures/beta_cristobalite_192.pdb

# q111 and q022 for beta-cristobalite with a=7.15 A.
xrd: SAXS ATOMS=1-192 ATOMISTIC QVALUE1=1.52207 EXPINT1=1.0 QVALUE2=2.48553 EXPINT2=1.0

# The regex prints all q-components produced by SAXS; check COLVAR header/log for exact component names.
PRINT ARG=(xrd\.q-.*) FILE=outputs/COLVAR_saxs_print.dat STRIDE=100
