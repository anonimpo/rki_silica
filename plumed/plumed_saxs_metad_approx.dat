# Approximate WTMetaD input using stock PLUMED SAXS as a Debye-intensity proxy.
# For a paper-level reproduction, use a PLUMED build that contains the development
# structure-factor/XRD CV used by Niu/Piaggi/Invernizzi/Parrinello, or implement that CV.

UNITS LENGTH=A TIME=fs ENERGY=kcal/mol
MOLINFO STRUCTURE=structures/beta_cristobalite_192.pdb

# q111 for beta-cristobalite with a=7.15 A. The paper biases s1=I(Q{111}).
xrd: SAXS ATOMS=1-192 ATOMISTIC ABSOLUTE QVALUE1=1.52207 EXPINT1=1.0

# Paper settings: bias factor 100; Gaussian every 1 ps; width 5 CV units; height 40 kJ/mol.
# Here dt=0.25 fs, so PACE=4000 steps = 1 ps. 40 kJ/mol = 9.560 kcal/mol.
# If your PLUMED log reports a different component name than xrd.q-0, replace ARG below.
metad: METAD ARG=xrd.q-0 SIGMA=5.0 HEIGHT=9.560 PACE=4000 BIASFACTOR=100 TEMP=2400 FILE=outputs/HILLS_saxs_approx

PRINT ARG=xrd.q-0,metad.bias FILE=outputs/COLVAR_saxs_metad_approx.dat STRIDE=100
