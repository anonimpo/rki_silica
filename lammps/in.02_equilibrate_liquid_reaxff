# Equilibrate liquid silica near target temperature using ReaxFF.
# Run after in.01_melt_reaxff.

units           real
atom_style      charge
boundary        p p p
newton          on

variable        T equal 2400.0
variable        P equal 1.0
variable        dt equal 0.25
variable        nsteps equal 80000      # 20 ps at 0.25 fs; extend for production
variable        dumpfreq equal 1000

read_data       structures/liquid_sio2_after_melt.data

neighbor        2.0 bin
neigh_modify    every 10 delay 0 check yes

pair_style      reaxff NULL safezone 1.6 mincap 100
pair_coeff      * * potentials/ffield.reax.SiOH Si O
fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff

timestep        ${dt}
fix             ens all npt temp ${T} ${T} 100.0 iso ${P} ${P} 10000.0

thermo          100
thermo_style    custom step time temp pe ke etotal press vol density

dump            d1 all custom ${dumpfreq} outputs/equil_liquid_reaxff.lammpstrj id type q x y z
dump_modify     d1 sort id

run             ${nsteps}

unfix           ens
undump          d1
write_data      structures/liquid_sio2_equilibrated_2400K.data
write_restart   outputs/liquid_sio2_equilibrated_2400K.restart
