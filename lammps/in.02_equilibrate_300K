# Stage 02: short 300 K NPT equilibration after minimization.
#   lmp -var phlabel pH7p0 -var baseatoms 1536 -in lammps/in.02_equilibrate_300K

clear
units           real
atom_style      charge
boundary        p p p
newton          on

variable        dt        equal 0.25
variable        seed      equal 912345
variable        rundir    string runs/${phlabel}_N${baseatoms}/02_equilibrate_300K
shell           mkdir -p ${rundir}
log             ${rundir}/log.lammps

read_data       runs/${phlabel}_N${baseatoms}/01_minimize/minimized.data

pair_style      reaxff NULL safezone 2.0 mincap 100
pair_coeff      * * potentials/ffield.reax.SiOH Si O H
neighbor        2.0 bin
neigh_modify    every 10 delay 0 check yes
fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff maxiter 200

timestep        ${dt}
velocity        all create 300.0 ${seed} mom yes rot yes dist gaussian
fix             npt300 all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000.0

thermo          500
thermo_style    custom step time temp press pe ke etotal vol density
thermo_modify   flush yes lost warn

dump            dmp all custom 1000 ${rundir}/eq300.lammpstrj id type q x y z vx vy vz
dump_modify     dmp sort id

run             ${nsteps}

write_data      ${rundir}/eq300.data
write_restart   ${rundir}/eq300.restart
unfix           npt300
unfix           qeq
undump          dmp
