# Stage 04: high-temperature unbiased ReaxFF trajectory for accelerated crystallization screening.
# Use for structural comparison and to obtain pre-MetaD CV ranges.
#   lmp -var phlabel pH7p0 -var baseatoms 1536 -var Tprod 2300 -in lammps/in.04_highT_unbiased_reaxff

clear
units           real
atom_style      charge
boundary        p p p
newton          on

variable        dt        equal 0.25
variable        rundir    string runs/${phlabel}_N${baseatoms}/04_highT_unbiased_${Tprod}K
shell           mkdir -p ${rundir}
log             ${rundir}/log.lammps

read_data       runs/${phlabel}_N${baseatoms}/03_calcination_1173K/calcined_1173K.data

pair_style      reaxff NULL safezone 2.0 mincap 100
pair_coeff      * * potentials/ffield.reax.SiOH Si O H
neighbor        2.0 bin
neigh_modify    every 10 delay 0 check yes
fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff maxiter 200

timestep        ${dt}
thermo          1000
thermo_style    custom step time temp press pe ke etotal vol density
thermo_modify   flush yes lost warn

dump            dmp all custom 2000 ${rundir}/traj_highT_unbiased.lammpstrj id type q x y z vx vy vz
dump_modify     dmp sort id
fix             rb all reaxff/bonds 2000 ${rundir}/bonds.reaxff

fix             heat all npt temp 1173.0 ${Tprod} 100.0 iso 1.0 1.0 1000.0
run             ${nheat}
unfix           heat

fix             prod all npt temp ${Tprod} ${Tprod} 100.0 iso 1.0 1.0 1000.0
run             ${nprod}
unfix           prod

write_data      ${rundir}/highT_unbiased_final.data
write_restart   ${rundir}/highT_unbiased_final.restart
unfix           rb
unfix           qeq
undump          dmp
