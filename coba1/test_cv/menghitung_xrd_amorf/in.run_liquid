# SKRIP LAMMPS: FINGERPRINT UNTUK FASE LIQUID / AMORF
units           real
atom_style      charge
boundary        p p p

# MEMBACA FILE HASIL TAHAP 1
read_data       ../membuat_amorf/amorphous_silica_300K.data

pair_style      reaxff NULL checkqeq yes
pair_coeff      * * ../potensial/ffield.reax.SiOH Si O

neighbor        2.5 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.5

thermo          1000
thermo_style    custom step temp pe ke press

fix             f_qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff

# Jalankan NVT singkat pada suhu yang sama (2400 K)
fix             f_nvt all nvt temp 2400.0 2400.0 50.0

# Panggil PLUMED untuk menghitung distribusi
fix             f_plumed all plumed plumedfile plumed.dat

# ==========================================================
# MENGHITUNG SPEKTRUM XRD
# ==========================================================
# 1.541838 adalah panjang gelombang sinar-X (Target Cu K-alpha)
# 1 2 adalah tipe atom (1 untuk Si, 2 untuk O)
# 2Theta 10 90 adalah rentang sudut (dari 10 hingga 90 derajat)
# c 1 1 1 adalah kerapatan grid reciprocal space (bisa dinaikkan jika kurang presisi, misal c 2 2 2)
# LP 1 berarti menyalakan faktor koreksi Lorentz-Polarization (seperti XRD asli)

#compute         myXRD all xrd 1.541838 1 2 2Theta 10 90 c 1 1 1 LP 1
compute         myXRD all xrd 1.541838 Si O 2Theta 10 90 c 1 1 1 LP 1
# Menyimpan hasil XRD ke dalam file teks (spektrum_xrd.txt)
# Data akan dirata-rata selama 50000 step
fix             outXRD all ave/time 100 500 50000 c_myXRD[1] c_myXRD[2] file spektrum_liquid_xrd.txt mode vector
# Jalankan selama 50.000 step untuk mengumpulkan statistik histogram
run             50000

# Ubah nama file output agar tidak tertimpa di langkah berikutnya
shell           mv histo2_q6avg data_fingerprint_liquid.txt
