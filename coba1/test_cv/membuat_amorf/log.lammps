LAMMPS (29 Aug 2024 - Update 1)
  using 1 OpenMP thread(s) per MPI task
# ====================================================================
# SKRIP LAMMPS: TAHAP 1 - MELT QUENCHING SILIKA (REAXFF)
# ====================================================================

units           real
atom_style      charge
boundary        p p p

# --------------------------------------------------------------------
# 1. BACA STRUKTUR AWAL
# --------------------------------------------------------------------
read_data       ../struktur/cristobalite_1536.data
Reading data file ...
  orthogonal box = (0 0 0) to (28.64 28.64 28.64)
  2 by 2 by 2 MPI processor grid
  reading atoms ...
  1536 atoms
  reading velocities ...
  1536 velocities
  read_data CPU = 0.012 seconds

# Re-assign jenis atom sesuai format potensial ReaxFF
# Tipe 1 = Si, tipe 2 = O
pair_style      reaxff NULL checkqeq yes
pair_coeff      * * ../potensial/ffield.reax.SiOH Si O
WARNING: Changed valency_val to valency_boc for X (src/REAXFF/reaxff_ffield.cpp:294)

# --------------------------------------------------------------------
# 2. PENGATURAN SIMULASI & THERMOSTAT
# --------------------------------------------------------------------
neighbor        2.5 bin
neigh_modify    delay 0 every 1 check yes

# Timestep ReaxFF = 0.5 femtosekon
timestep        0.5

thermo          1000
thermo_style    custom step temp pe ke etotal press vol density

fix             f_qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff

# Set dump di awal agar SELURUH proses (melt + quench) terekam untuk analisis
dump            d_trajectory all custom 2000 trajectory_amorf.lammpstrj id type x y z q

# --------------------------------------------------------------------
# 3. PROSES A: ELEVASI & PELELEHAN (MELTING) TO 5500 K
# --------------------------------------------------------------------
print "====================================================="
=====================================================
print " Memulai Fase Pelelehan (Melting) ke 5500 K..."
 Memulai Fase Pelelehan (Melting) ke 5500 K...
print "====================================================="
=====================================================

# Elevasi suhu 300 K -> 5500 K selama 100,000 step (50 ps)
fix             f_md all npt temp 300.0 5500.0 50.0 iso 1.0 1.0 500.0
run             100000

