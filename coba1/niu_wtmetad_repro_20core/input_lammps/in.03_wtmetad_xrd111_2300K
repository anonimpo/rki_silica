# WTMETAD check: bias Si-only Debye-style XRD {111} CV.
# Output target: final XRD should develop sharper beta-cristobalite-like peaks if the bias is effective.
units           real
atom_style      charge
boundary        p p p
read_data       ${DATA}
include         input_lammps/include_reaxff_pure_sio2.inc

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        ${DT}
velocity        all create 2300.0 24680 mom yes rot yes dist gaussian
fix             nvt all nvt temp 2300.0 2300.0 100.0

# Per LAMMPS docs, fix plumed is placed after relevant input parameters such as timestep.
fix             fplumed all plumed plumedfile custom_cv/plumed_xrd111_si_matrix_WTMETAD_v210.dat outfile logs/plumed_xrd111_wtmetad.log

dump            dwt all custom ${DUMP_STRIDE} outputs/dump_03_wtmetad_xrd111_2300K.lammpstrj id type q x y z
thermo          1000
thermo_style    custom step temp pe etotal press vol density f_fplumed
run             ${RUN_STEPS}

write_data      structures/wtmetad_xrd111_after_2300K_N1536.data
write_restart   structures/wtmetad_xrd111_after_2300K_N1536.restart
