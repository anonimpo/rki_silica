# Unbiased control at 2300 K: should stay broad/diffuse much more than WTMETAD.
units           real
atom_style      charge
boundary        p p p
read_data       ${DATA}
include         input_lammps/include_reaxff_pure_sio2.inc

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        ${DT}
velocity        all create 2300.0 98765 mom yes rot yes dist gaussian
fix             nvt all nvt temp 2300.0 2300.0 100.0

dump            dunb all custom ${DUMP_STRIDE} outputs/dump_02_unbiased_2300K.lammpstrj id type q x y z
thermo          1000
thermo_style    custom step temp pe etotal press vol density
run             ${RUN_STEPS}

write_data      structures/unbiased_after_2300K_N1536.data
write_restart   structures/unbiased_after_2300K_N1536.restart
