# Fallback WTMETAD using PLUMED 2.10 ENVIRONMENTSIMILARITY.
# Not the exact Niu method, but useful if matrix XRD CV fails in your PLUMED build.
units           real
atom_style      charge
boundary        p p p
read_data       ${DATA}
include         input_lammps/include_reaxff_pure_sio2.inc

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        ${DT}
velocity        all create 2300.0 13579 mom yes rot yes dist gaussian
fix             nvt all nvt temp 2300.0 2300.0 100.0
fix             fplumed all plumed plumedfile custom_cv/plumed_envsimilarity_fallback_WTMETAD_v210.dat outfile logs/plumed_envsim_wtmetad.log

dump            denv all custom ${DUMP_STRIDE} outputs/dump_04_wtmetad_envsim_2300K.lammpstrj id type q x y z
thermo          1000
thermo_style    custom step temp pe etotal press vol density f_fplumed
run             ${RUN_STEPS}

write_data      structures/wtmetad_envsim_after_2300K_N1536.data
write_restart   structures/wtmetad_envsim_after_2300K_N1536.restart
