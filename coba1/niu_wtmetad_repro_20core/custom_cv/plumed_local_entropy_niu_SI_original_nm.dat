# Original-style local entropy input copied conceptually from Niu Supporting Information.
# Use this only if your PLUMED build accepts the older SPECIES/SIGMA/NHIST syntax.
# Otherwise use plumed_local_entropy_fig7_v210_adapted.dat.
PAIRENTROPIES ...
LABEL=s1
SPECIES=1-1536:24,2-1536:24,3-1536:24,4-1536:24,5-1536:24,6-1536:24,7-1536:24,8-1536:24
MAXR=0.75
SIGMA=0.05
NHIST=201
LOWMEM
... PAIRENTROPIES
LOCAL_AVERAGE SPECIES=s1 SWITCH={RATIONAL R_0=0.425 D_MAX=0.45 NN=50 MM=100} LOWMEM LABEL=sa
hh1: HISTOGRAM DATA=s1 GRID_MIN=-10.0 GRID_MAX=0.0 GRID_BIN=1000 BANDWIDTH=0.05 STRIDE=1000
DUMPGRID GRID=hh1 FILE=histo1 STRIDE=1000
hh2: HISTOGRAM DATA=sa GRID_MIN=-10.0 GRID_MAX=0.0 GRID_BIN=1000 BANDWIDTH=0.05 STRIDE=1000
DUMPGRID GRID=hh2 FILE=histo2 STRIDE=1000
DUMPMULTICOLVAR FILE=MULTICOLVAR-AVG.xyz STRIDE=1000 DATA=sa
PRINT STRIDE=1000 ARG=* FILE=COLVAR
