# PLUMED 2.10 WTMETAD on Si-only Debye-style XRD {111} CV.
# Niu parameters mapped to ReaxFF-safe timestep setup:
# - Niu: Gaussian every 1 ps, SIGMA=5 CV units, HEIGHT=40 kJ/mol, BIASFACTOR=100.
# - LAMMPS real energy: 40 kJ/mol = 9.560 kcal/mol.
# - If timestep is 0.25 fs, 1 ps = 4000 steps. If timestep is 2 fs, use PACE=500.
UNITS LENGTH=A ENERGY=kcal/mol TIME=fs

si: GROUP ATOMS=1-512
dm: DISTANCE_MATRIX GROUP=si CUTOFF=12.0 COMPONENTS
xrdm: CUSTOM ARG=dm.w VAR=r FUNC=(sin(1.522*sqrt(r*r+1e-12))/(1.522*sqrt(r*r+1e-12)))*(sin(3.141592653589793*sqrt(r*r+1e-12)/12.0)/(3.141592653589793*sqrt(r*r+1e-12)/12.0))*step(12.0-r) PERIODIC=NO
s1raw: SUM ARG=xrdm PERIODIC=NO
s1: CUSTOM ARG=s1raw VAR=x FUNC=x/512.0 PERIODIC=NO

mtd: METAD ...
  ARG=s1
  SIGMA=5.0
  HEIGHT=9.560
  PACE=4000
  BIASFACTOR=100
  TEMP=2300
  FILE=../outputs/HILLS_XRD111
  GRID_MIN=0
  GRID_MAX=700
  GRID_BIN=1400
... METAD

PRINT STRIDE=400 ARG=s1,mtd.bias FILE=../outputs/COLVAR_XRD111_WTMETAD
