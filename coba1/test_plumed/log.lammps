# Membuat box simulasi kecil dan mengisinya dengan beberapa atom
lattice         fcc 4.05
Lattice spacing in x,y,z = 4.05 4.05 4.05
region          box block 0 3 0 3 0 3
create_box      1 box
Created orthogonal box = (0 0 0) to (12.15 12.15 12.15)
  1 by 1 by 1 MPI processor grid
create_atoms    1 box
Created 108 atoms
  using lattice units in orthogonal box = (0 0 0) to (12.15 12.15 12.15)
  create_atoms CPU = 0.000 seconds

# --- PERBAIKAN LAMMPS: Menentukan massa atom tipe 1 ---
mass            1 26.98  # Menggunakan massa dummy (misal: Aluminium)

# Menentukan potensial dummy (Lennard-Jones) agar LAMMPS tidak error
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

# Pengaturan termodinamika singkat
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes
fix             1 all nve

print "Menghubungkan ke file plumed.dat..."
Menghubungkan ke file plumed.dat...
fix             2 all plumed plumedfile plumed.dat outfile plumed.out

# Jalankan 1-2 langkah saja untuk mengecek kestabilan
timestep        0.001
thermo          1

print "Menjalankan run dummy untuk tes kestabilan fitur..."
