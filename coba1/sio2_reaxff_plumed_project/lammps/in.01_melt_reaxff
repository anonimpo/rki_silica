# Melt beta-cristobalite to obtain liquid silica using ReaxFF.
# This is deliberately conservative for ReaxFF: dt=0.25 fs. Increase only after testing energy stability.
# Run after in.00_minimize_reaxff.

units           real
atom_style      charge
boundary        p p p
newton          on

variable        Tmelt equal 4000.0
variable        P equal 1.0
variable        dt equal 0.25
variable        nsteps equal 40000      # 10 ps at 0.25 fs; extend for production
variable        dumpfreq equal 1000

read_data       structures/beta_cristobalite_192_min.data

neighbor        2.0 bin
neigh_modify    every 10 delay 0 check yes

pair_style      reaxff NULL safezone 1.6 mincap 100
pair_coeff      * * potentials/ffield.reax.SiOH Si O
fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff

timestep        ${dt}
velocity        all create ${Tmelt} 4928459 mom yes rot yes dist gaussian

# Paper uses stochastic velocity rescaling and Parrinello-Rahman at tau_T=0.1 ps, tau_P=10 ps.
# LAMMPS built-in fix npt is a Nose-Hoover style alternative with matching damping times.
fix             ens all npt temp ${Tmelt} ${Tmelt} 100.0 iso ${P} ${P} 10000.0

thermo          100
thermo_style    custom step time temp pe ke etotal press vol density

dump            d1 all custom ${dumpfreq} outputs/melt_reaxff.lammpstrj id type q x y z
dump_modify     d1 sort id

run             ${nsteps}

unfix           ens
undump          d1
write_data      structures/liquid_sio2_after_melt.data
write_restart   outputs/liquid_sio2_after_melt.restart
