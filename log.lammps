LAMMPS (29 Aug 2024)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
# ReaxFF + PLUMED well-tempered metadynamics.
# IMPORTANT: this requires ONE LAMMPS executable compiled with BOTH REAXFF and PLUMED packages.
# Run after in.02_equilibrate_liquid_reaxff.

units           real
atom_style      charge
boundary        p p p
newton          on

variable        T equal 2400.0
variable        P equal 1.0
variable        dt equal 0.25
variable        nsteps equal 400000     # 100 ps at 0.25 fs; production likely needs much longer
variable        dumpfreq equal 1000

read_data       structures/liquid_sio2_equilibrated_2400K.data
Reading data file ...
  orthogonal box = (0.0037150005 0.0037150005 0.0037150005) to (14.296285 14.296285 14.296285)
  2 by 2 by 2 MPI processor grid
  reading atoms ...
  192 atoms
  reading velocities ...
  192 velocities
  read_data CPU = 0.003 seconds

neighbor        2.0 bin
neigh_modify    every 10 delay 0 check yes

pair_style      reaxff NULL safezone 1.6 mincap 100
pair_coeff      * * potentials/ffield.reax.SiOH Si O
WARNING: Changed valency_val to valency_boc for X (src/REAXFF/reaxff_ffield.cpp:294)
fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff

timestep        ${dt}
timestep        0.25

# PLUMED must be after timestep is set and before any fixes that compute pressure internally (e.g. fix npt).
# The included plumed_saxs_metad_approx.dat is an approximate stock-PLUMED path, not an exact paper CV.
fix             plm all plumed plumedfile plumed/plumed_saxs_metad_approx.dat outfile logs/plumed_wtmetad.log

fix             ens all npt temp ${T} ${T} 100.0 iso ${P} ${P} 10000.0
fix             ens all npt temp 2400 ${T} 100.0 iso ${P} ${P} 10000.0
fix             ens all npt temp 2400 2400 100.0 iso ${P} ${P} 10000.0
fix             ens all npt temp 2400 2400 100.0 iso 1 ${P} 10000.0
fix             ens all npt temp 2400 2400 100.0 iso 1 1 10000.0

thermo          100
thermo_style    custom step time temp pe ke etotal press vol density

dump            d1 all custom ${dumpfreq} outputs/wtmetad_reaxff_plumed.lammpstrj id type q x y z
dump            d1 all custom 1000 outputs/wtmetad_reaxff_plumed.lammpstrj id type q x y z
dump_modify     d1 sort id

run             ${nsteps}
run             400000

